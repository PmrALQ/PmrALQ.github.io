[{"data":1,"prerenderedAt":410},["ShallowReactive",2],{"home-works":3},[4,307],{"id":5,"title":6,"body":7,"date":281,"demoUrl":282,"description":283,"extension":284,"meta":285,"navigation":286,"path":287,"seo":288,"sourceUrl":282,"stem":289,"tags":290,"tech":294,"thumbnail":304,"type":292,"__hash__":305,"_type":306},"projects\u002Fzh\u002Fprojects\u002Fskyask.md","飞问 SkyAsk",{"type":8,"value":9,"toc":265},"minimark",[10,14,18,22,25,28,75,78,147,150,156,162,168,174,177,194,197,200,204,215,218,238,241,252,255],[11,12,6],"h1",{"id":13},"飞问-skyask",[15,16,17],"h2",{"id":17},"这是什么",[19,20,21],"p",{},"一个面向民航理论考试的刷题系统，覆盖私照、商照、仪表等级等科目的题库。它不是简单的「选择题 + 下一题」，而是把刷题、错题复盘、模拟考试、社区交流和答疑串成一条完整的学习链路；项目里还住着一个叫「云朵」的学习助手——一个不直接给答案、只做引导的 AI 陪练。",[19,23,24],{},"学习过程中你会拥有一朵会成长的云：从「小云」起步，一路进阶到「积云」「卷云」，最终抵达「彩虹云」，每一点刷题与社区贡献都会具象成它的成长。",[15,26,27],{"id":27},"主要功能",[29,30,31,39,45,51,57,63,69],"ul",{},[32,33,34,38],"li",{},[35,36,37],"strong",{},"刷题","：单选 \u002F 多选 \u002F 判断 \u002F 填空四种题型；选项可打乱，判分按题型归一化（多选忽略顺序，填空忽略大小写与空格）",[32,40,41,44],{},[35,42,43],{},"错题本与收藏","：错题自动归集，收藏状态按用户实时同步",[32,46,47,50],{},[35,48,49],{},"筛选与检索","：按题型、难度筛选，支持题目关键词搜索",[32,52,53,56],{},[35,54,55],{},"模拟考试","：30 分钟倒计时，最后 5 分钟红色告警，到时自动交卷",[32,58,59,62],{},[35,60,61],{},"学习统计与成长","：今日已刷、连续打卡、近 7 天正确率趋势，以及「薄弱知识点」视角；随学习进度解锁四阶成长云（小云 → 积云 → 卷云 → 彩虹云）",[32,64,65,68],{},[35,66,67],{},"AI 答疑","：可针对某道题追问，也可脱题通用提问；对话历史可恢复；「云朵」只引导、不直接给答案",[32,70,71,74],{},[35,72,73],{},"社区","：信息流 + 发帖 + 点赞 + 评论，分「推荐 \u002F 求助 \u002F 笔记 \u002F 经验」四栏，发帖与获赞都能累积成长积分——把一个人的备考变成一群人的互助",[15,76,77],{"id":77},"技术栈",[79,80,81,94],"table",{},[82,83,84],"thead",{},[85,86,87,91],"tr",{},[88,89,90],"th",{},"层",[88,92,93],{},"选型",[95,96,97,106,114,127,135],"tbody",{},[85,98,99,103],{},[100,101,102],"td",{},"前端",[100,104,105],{},"React 18 + Vite + TypeScript（strict）+ Tailwind CSS + Radix UI",[85,107,108,111],{},[100,109,110],{},"表单与校验",[100,112,113],{},"react-hook-form + Zod",[85,115,116,119],{},[100,117,118],{},"后端",[100,120,121,122,126],{},"Node.js + Express + SQLite（Vite 代理 ",[123,124,125],"code",{},"\u002Fapi","）",[85,128,129,132],{},[100,130,131],{},"移动端",[100,133,134],{},"Flutter（与 Web 共用同一套题库与判分规则，规划移植中）",[85,136,137,140],{},[100,138,139],{},"工程化",[100,141,142,143,146],{},"ESLint + Prettier，",[123,144,145],{},"pnpm check","（type-check + lint）作为统一质量门禁",[15,148,149],{"id":149},"开发心得",[19,151,152,155],{},[35,153,154],{},"「判分规则单一权威」是这次最深的功课。"," 同一道题，前端与后端都要各自判分——只要归一化规则有一处不一致，就会出现「网页判对、接口判错」这类极难复现的问题。最后我把判分逻辑收敛为同一套规则，并把「改动判分必须前后端同步」当成一条硬约束。",[19,157,158,161],{},[35,159,160],{},"把「静默失败」一个个揪出来。"," 项目初期大量 catch 是空的：接口挂了、刷新失败，界面什么都不说，用户只觉得「点了没反应」。后来统一补上 Toast 反馈、会话过期提示、路由级 ErrorBoundary，把「看不见的错误」变成「看得见的提示」。这类改动不增加功能，但体验差别很大。",[19,163,164,167],{},[35,165,166],{},"AI 助手不该替学生做题。"," 「云朵」最初会把正确答案塞进上下文，于是它的回答就是复述答案。改成苏格拉底式引导后——只提示思路、反问关键条件——它的定位才真正变成陪练，而不是答案机器。这个取舍比接模型本身更值得琢磨。",[19,169,170,173],{},[35,171,172],{},"顺手的地方，都是先被别扭过的地方。"," 触屏上打不开的悬停菜单、刷新就丢的科目名、迟到 5 分钟的统计、打断答题流程的原生弹窗……这一串「小问题」，正好构成了从「能跑」到「好用」之间的距离。",[15,175,176],{"id":176},"待改进",[29,178,179,182,185,188,191],{},[32,180,181],{},"题库导入目前依赖手工整理，想做一个更顺手的录题 \u002F 批量导入流程",[32,183,184],{},"错题本已支持「薄弱知识点」分析，但按知识点聚合的批量复习视图仍在完善",[32,186,187],{},"希望「云朵」从纯文字答疑扩展到能看图讲解",[32,189,190],{},"Web 端当前为手机壳形态，后续需要补一套网页专属的桌面布局",[32,192,193],{},"Flutter 原生 App 端待 Web 端验收完成后移植",[15,195,196],{"id":196},"项目组招募",[19,198,199],{},"飞问 SkyAsk 是一个还在快速迭代的开源学习项目，我们想把它做成民航理论考生真正用得顺手的「刷题 + 答疑」工具。如果你也感兴趣，欢迎加入。",[201,202,203],"h3",{"id":203},"我们在做什么",[29,205,206,209,212],{},[32,207,208],{},"把刷题、错题复盘、模拟考试、社区交流和 AI 答疑串成一条完整学习链路",[32,210,211],{},"打磨「云朵」——一个苏格拉底式引导、不替你做题的学习陪练",[32,213,214],{},"持续扩充并校准私照 \u002F 商照 \u002F 仪表等科目的题库",[201,216,217],{"id":217},"招募方向",[29,219,220,223,226,229,232,235],{},[32,221,222],{},"前端（React \u002F Vite \u002F TypeScript \u002F Tailwind）：Web 功能开发与桌面化布局",[32,224,225],{},"移动端（Flutter）：App 端移植与维护",[32,227,228],{},"后端（Node \u002F Express \u002F SQLite）：社区、积分、AI 接入等能力",[32,230,231],{},"AI \u002F 算法：云朵引导策略优化、自研答疑 agent、看图讲解",[32,233,234],{},"题库 \u002F 内容：民航理论题目的整理、校验与录入",[32,236,237],{},"设计 \u002F 产品：云朵 IP 与交互体验",[201,239,240],{"id":240},"我们希望你",[29,242,243,246,249],{},[32,244,245],{},"对民航理论考试或教育类工具感兴趣（有备考经历更佳，非必需）",[32,247,248],{},"有一门能上手的技术栈，或愿意边做边学",[32,250,251],{},"能稳定投入、接受小步快跑的迭代节奏",[201,253,254],{"id":254},"如何加入",[29,256,257],{},[32,258,259,260],{},"联系方式：",[261,262,264],"a",{"href":263},"mailto:PmrALQ@Outlook.com","PmrALQ@Outlook.com",{"title":266,"searchDepth":267,"depth":267,"links":268},"",2,[269,270,271,272,273,274],{"id":17,"depth":267,"text":17},{"id":27,"depth":267,"text":27},{"id":77,"depth":267,"text":77},{"id":149,"depth":267,"text":149},{"id":176,"depth":267,"text":176},{"id":196,"depth":267,"text":196,"children":275},[276,278,279,280],{"id":203,"depth":277,"text":203},3,{"id":217,"depth":277,"text":217},{"id":240,"depth":277,"text":240},{"id":254,"depth":277,"text":254},"2026-07-31",null,"民航理论考试刷题系统。React + Vite + TypeScript 前端，Node \u002F Express \u002F SQLite 后端，内置苏格拉底式引导的 AI 学习助手「云朵」。当前以 Web 端为产品主体（移动端采用手机壳形态，在浏览器中即可预览 App 效果）；Flutter 原生 App 计划在 Web 端验收完成后平移移植。","md",{},true,"\u002Fzh\u002Fprojects\u002Fskyask",{"title":6,"description":283},"zh\u002Fprojects\u002Fskyask",[291,292,293],"作品分享","web","app",[295,296,297,298,299,300,301,302,303],"React 18","TypeScript","Vite","Tailwind CSS","Radix UI","Node.js","Express","SQLite","Flutter","\u002Fimages\u002Fprojects\u002Fskyask-hero.jpg","-v7NKfb_mAD1nXpoS8E_3fJ7dCjn1ay5rk_awCH8cl4","project",{"id":308,"title":309,"body":310,"date":400,"description":401,"extension":284,"meta":402,"navigation":286,"path":403,"seo":404,"stem":405,"tags":406,"__hash__":408,"_type":409},"content\u002Fzh\u002Fblog\u002Fhello-world.md","Hello, World!",{"type":8,"value":311,"toc":396},[312,315,330,333,357,367,370,373,393],[11,313,309],{"id":314},"hello-world",[19,316,317,318,321,322,325,326,329],{},"欢迎来到我的个人博客！\n这里是 ",[35,319,320],{},"PmrALQ","，今天终于把用 ",[35,323,324],{},"Nuxt 3"," + ",[35,327,328],{},"Nuxt Content"," 搭建的个人网站肝出来啦 ☆˶> x \u003C˶.⁺ ",[15,331,332],{"id":332},"关于这个博客的技术栈",[29,334,335,340,346,351],{},[32,336,337,339],{},[35,338,324],{}," — Vue.js 全栈框架，SSG 静态生成模式",[32,341,342,345],{},[35,343,344],{},"Nuxt Content v3"," — Markdown 驱动的内容管理",[32,347,348,350],{},[35,349,298],{}," — 告别手写 CSS 的痛苦",[32,352,353,356],{},[35,354,355],{},"@nuxtjs\u002Fi18n"," — 中英文双语，欢迎世界各地的访客 ˶>ᗜ\u003C˶",[19,358,359,362,363,366],{},[35,360,361],{},"以及","：",[364,365],"br",{},"\n支持深色模式一键切换，响应式设计，适配移动端和桌面端，随时随地都能来找我玩喵",[15,368,369],{"id":369},"接下来的主线任务",[19,371,372],{},"这里不会长草的！未来我会持续更新以下内容：",[29,374,375,381,387],{},[32,376,377,380],{},[35,378,379],{},"学习总结"," — 踩坑记录、经验分享",[32,382,383,386],{},[35,384,385],{},"前沿技术"," — 分享项目经验 (#^.^#)",[32,388,389,392],{},[35,390,391],{},"算法练习"," — 记录我的算法竞赛道路（？？？）",[19,394,395],{},"如果觉得有趣的话，欢迎在留言区戳我互动哦 (｡- .•)",{"title":266,"searchDepth":267,"depth":267,"links":397},[398,399],{"id":332,"depth":267,"text":332},{"id":369,"depth":267,"text":369},"2026-06-25","属于 PmrALQ 的个人博客，今日正式上线啦！(ﾉ>ω\u003C)ﾉ",{},"\u002Fzh\u002Fblog\u002Fhello-world",{"title":309,"description":401},"zh\u002Fblog\u002Fhello-world",[407],"经验总结","26DwbQHXqswfczl_qbrtll_H4CntQ85ArhI10VC9uZs","post",1790504321575]